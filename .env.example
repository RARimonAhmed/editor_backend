# ==============================================================================
# TechXayan Creative - my_editor Production Environment Configuration
# Copy this file to .env and configure real infrastructure credentials.
# In production (NODE_ENV=production):
#  - ALLOW_DEV_FALLBACKS must be false
#  - STORAGE_DRIVER must be 's3' (mock is prohibited)
#  - REDIS_ENABLE_FALLBACK must be false
#  - Strong, unique secrets must be used (default placeholders will fail fast)
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info
ALLOW_DEV_FALLBACKS=false

# Security & Authentication (Replace with random 64-char strings)
JWT_SECRET=replace_with_a_secure_random_64_char_hex_or_base64_string_in_prod
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_char_hex_or_base64_string_in_prod
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=https://editor.techxayan.com,https://admin.techxayan.com,capacitor://localhost,app://my-editor
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ==============================================================================
# Production PostgreSQL Connection & Pool Settings
# ==============================================================================
DATABASE_URL=postgresql://app_user:prod_password_here@postgres-cluster.internal:5432/my_editor_production
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONN_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional base64 or PEM-encoded CA certificate for managed PostgreSQL (AWS RDS, Aurora, Cloud SQL)
# DATABASE_SSL_CA=

# ==============================================================================
# Production Redis & BullMQ Queue Configuration
# ==============================================================================
REDIS_URL=rediss://default:redis_cluster_password_here@redis-cluster.internal:6379
# Optional dedicated password if not embedded in URL
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES=10
# In production, silent in-memory fallback must be disabled:
REDIS_ENABLE_FALLBACK=false

# ==============================================================================
# Production Object Storage (AWS S3 / MinIO / Cloudflare R2 / GCS S3-compatible)
# ==============================================================================
# Driver MUST be 's3' in production
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=my-editor-production-media
STORAGE_ACCESS_KEY=your_production_s3_access_key
STORAGE_SECRET_KEY=your_production_s3_secret_key
# Set to false for native AWS S3, set to true for MinIO/R2/Localstack
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL_PREFIX=https://media.techxayan.com/my-editor-production-media
STORAGE_TEMP_PREFIX=temp/uploads
STORAGE_FINAL_PREFIX=projects
# Maximum upload size in bytes (e.g. 5368709120 = 5GB)
STORAGE_MAX_UPLOAD_SIZE_BYTES=5368709120
STORAGE_SIGNED_URL_EXPIRES_IN_SECONDS=3600

# ==============================================================================
# AI Video Services & Providers ("openai" | "gemini" | "mock" in dev only)
# ==============================================================================
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=your-production-openai-api-key
GEMINI_API_KEY=your-production-gemini-api-key

# ==============================================================================
# Background Worker & Transcoding Engine
# ==============================================================================
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=2000
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ==============================================================================
# Webhooks & Billing
# ==============================================================================
STRIPE_SECRET_KEY=sk_live_replace_with_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret
INTERNAL_WEBHOOK_SECRET=replace_with_internal_worker_shared_secret_min_32_chars
