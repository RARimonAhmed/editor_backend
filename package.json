{
  "name": "my-editor-backend-root",
  "version": "1.0.0",
  "private": true,
  "description": "TechXayan Creative - my_editor backend root orchestrator",
  "scripts": {
    "install:all": "npm --prefix backend install",
    "dev": "npm --prefix backend run dev",
    "dev:worker": "npm --prefix backend run dev:worker",
    "build": "npm --prefix backend run build",
    "build:admin": "npm --prefix admin run build",
    "dev:admin": "npm --prefix admin run dev",
    "build:all": "npm --prefix admin run build && npm --prefix backend run build",
    "start": "npm --prefix backend run start",
    "start:worker": "npm --prefix backend run start:worker",
    "test": "npm --prefix backend run test",
    "typecheck": "npm --prefix backend run typecheck",
    "lint": "npm --prefix backend run lint",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:dev:up": "docker compose -f docker/docker-compose.dev.yml up -d"
  },
  "keywords": [
    "video-editor",
    "backend",
    "fastify",
    "typescript",
    "webrtc",
    "websocket",
    "ai-video"
  ],
  "author": "TechXayan Creative",
  "license": "UNLICENSED"
}
